# Global / System Environment Template for LiveInspectAI

# App mode
APP_ENV=development
LOG_LEVEL=INFO

# Backend configuration
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SECRET_KEY=change-this-in-production-to-a-random-secret-key-32-chars

# Agent Gateway
AGENT_ID=agent-win-gtx1660ti
AGENT_TOKEN=liveinspect-secret-agent-token-xyz-123
AGENT_HEARTBEAT_SECONDS=15
INFERENCE_TIMEOUT_SECONDS=30
MAX_INFERENCE_QUEUE=5

# Database & Storage
DATABASE_URL=sqlite+aiosqlite:///./liveinspect.db
SAVE_IMAGES=false

# Optional Cloud Supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=public-anon-key
# SUPABASE_SERVICE_ROLE_KEY=private-service-role-key
